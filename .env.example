# Referencia central de variables. Cada app tiene su propio .env.example:
#   apps/web/.env.example      -> se copia a apps/web/.env
#   apps/engine/.env.example   -> se copia a apps/engine/.env
#
# WEB (Vercel / Cloudflare Pages) - claves PUBLICAS:
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
#   VITE_ENGINE_URL
#
# ENGINE (Railway) - claves SECRETAS:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY   <-- nunca en la web
#   PORT
#   ADMIN_ORIGINS
#   WA_SESSION_ID
#   HORARIO_TZ_OFFSET
