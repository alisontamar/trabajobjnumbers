# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key: SECRETO. Solo aca, nunca en la web.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Servidor ----
# Railway inyecta PORT solo; en local usa 8080.
PORT=8080

# Origenes permitidos para el panel (separados por coma). Sin barra final.
ADMIN_ORIGINS=http://localhost:5173

# ---- WhatsApp / motor ----
# Una sesion Baileys por sucursal (se arrancan automaticamente al iniciar,
# leyendo la tabla sucursales). No hace falta configurar nada aca.
# Offset horario para la ventana de envio. Bolivia = -4 (sin horario de verano).
HORARIO_TZ_OFFSET=-4

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info
